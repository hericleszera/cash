    e.preventDefault();
    alert('Obrigado pelo contato! Entraremos em breve.');
    setFormData({ name: '', phone: '', email: '', message: '' });
  };
  const nextTestimonial = () => {
    setCurrentTestimonial((prev) => (prev + 1) % testimonials.length);
  };
