import { useState } from 'react';

interface Service {
  id: number;
  title: string;
  description: string;
  icon: string;
}

interface Testimonial {
  id: number;
  name: string;
  text: string;
  role: string;
}

interface TeamMember {
  id: number;
  name: string;
  role: string;
  specialty: string;
}

const services: Service[] = [
  {
    id: 1,
